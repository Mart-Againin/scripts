# ─────────────────────────────────────────────────────────────
# TG Analytics — конфигурационный файл
# Скопируйте этот файл как .env и заполните значения
# ─────────────────────────────────────────────────────────────

# Telegram API — получить на https://my.telegram.org
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890

# Имя файла сессии (без расширения)
SESSION_NAME=tg_analytics

# Каналы для анализа — @username или числовой ID через запятую
CHANNELS=@channel_one,@channel_two,@channel_three

# ── Получатели отчётов ─────────────────────────────────────────────
# REPORT_RECIPIENT_ID — получают отчёты И по расписанию (автоматически
# каждую неделю/месяц), И могут запросить командой /report в любой момент.
REPORT_RECIPIENT_ID=123456789,987654321

# ── Режим отладки ──────────────────────────────────────────
# DEBUG=true — подробные логи, ежедневные отчёты, отправка на DEBUG_RECIPIENT_ID
DEBUG=false
DEBUG_RECIPIENT_ID=987654321

# MODERATOR_IDS — могут запрашивать отчёты командой /report,
# но НЕ входят в автоматическую рассылку по расписанию.
# Любой отчёт, запрошенный командой, приходит лично тому, кто его запросил —
# не дублируется остальным, независимо от того, в каком он поле.
MODERATOR_IDS=

# ── Расписание ─────────────────────────────────────────────
# Часовой пояс для расписания отчётов (например Europe/Moscow)
TIMEZONE=Europe/Moscow

# Время ежедневного тестового отчёта (только при DEBUG=true), формат HH:MM
DAILY_REPORT_TIME=12:00

# ── Папки ──────────────────────────────────────────────────
OUTPUT_DIR=output
REGISTRY_DIR=registry
ARCHIVE_DIR=archive
LOGS_DIR=logs

# ── Веса CQI ───────────────────────────────────────────────
CQI_W_REACT=1
CQI_W_VOTE=2
CQI_W_FORWARD=4
CQI_W_COMMENT=5

# ── Прокси (опционально) ───────────────────────────────────
# PROXY_TYPE=socks5
# PROXY_HOST=127.0.0.1
# PROXY_PORT=1080
# PROXY_USERNAME=
# PROXY_PASSWORD=

# ── Google Sheets — выгрузка месячного отчёта ──────────────
# Инструкция: console.cloud.google.com → Service Account → скачать JSON-ключ
# Поделитесь таблицей с email из JSON-ключа (права редактора)
GOOGLE_SHEETS_CREDENTIALS=C:\Python_scripts\tg_analytics_v2\service_account.json
GOOGLE_SHEETS_ID=

# ── Google Sheets — платные размещения ─────────────────────
# Отдельная таблица с данными о платных посевах.
# Структура листа (колонки по порядку):
#   A: Площадка/название размещения — тип определяется отсюда:
#      содержит слово "папка" → тип "папка", иначе → полное название
#   B: Ссылка
#   C: Дата (ДД.ММ или ДД.ММ.ГГГГ)
#   D: Статус
#   E: Подписчики
#   F: Ср. охват 1 публикации
#   G: Стоимость
#   H: Охват
#   I: CPV  (скрипт считает сам)
#   J: CPM  (скрипт считает сам)
#   K: Приток подписчиков/заявок
#   L: CPF/CPL (скрипт считает сам)
#   M: Формат (не используется)
# Строки-заголовки каналов: зелёный фон, текст = название канала из дашборда,
# нет даты. Название должно совпадать с именем канала в DASHBOARD_CH_*.
GOOGLE_PAID_SHEET_URL=

# ── Dashboard (PPTX-презентация) ───────────────────────────
# Количество месяцев для графиков динамики
DASHBOARD_MONTHS_HISTORY=6

# Переопределение имён и цветов каналов для дашборда (опционально)
# Формат: DASHBOARD_CH_<username>=Имя:#ЦВЕТ
# По умолчанию используются значения из кода (config.py)
# Имя должно совпадать с названием канала в Google Sheets (платные размещения)
# DASHBOARD_CH_ktsdaily=Программисты:#EF4444
# DASHBOARD_CH_metaclass=Метакласс:#2E7D32
# DASHBOARD_CH_kts_specials=Геймификация:#EC407A
# DASHBOARD_CH_smartbotpro=Смартбот:#29ABE2
# DASHBOARD_CH_inside_ai_tech=Внутри AI:#111111
# DASHBOARD_CH_kod_v_kaske=Код в каске:#FB8C00
